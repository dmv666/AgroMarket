# Copia este archivo a .env y ajusta los valores para desarrollo local.
# docker-compose.yml lo lee automáticamente.

# --- Django ---
DEBUG=True
SECRET_KEY=change-me-in-production-please
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos (Postgres, servicio "db" en docker-compose) ---
POSTGRES_DB=campo_directo
POSTGRES_USER=campo_directo
POSTGRES_PASSWORD=campo_directo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# El frontend no necesita variables propias: en desarrollo llama a rutas
# relativas (/api, /ws) y vite.config.ts las redirige al backend.
