# Copia este archivo a .env y ajusta los valores para desarrollo local.
# docker-compose.yml lo lee automáticamente.

# --- Django ---
DEBUG=True
SECRET_KEY=change-me-in-production-please
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL absoluta desde la que el NAVEGADOR (no otro contenedor) descarga
# fotos de publicaciones y documentos de verificación. Debe ser la URL
# publicada del backend — en desarrollo local, el puerto expuesto por
# docker-compose (ver README: "por qué MEDIA_URL es absoluta").
MEDIA_URL=http://localhost:8000/media/

# --- Base de datos (Postgres, servicio "db" en docker-compose) ---
POSTGRES_DB=agromarket
POSTGRES_USER=agromarket
POSTGRES_PASSWORD=agromarket
POSTGRES_HOST=db
POSTGRES_PORT=5432

# El frontend no necesita variables propias: en desarrollo llama a rutas
# relativas (/api, /ws) y vite.config.ts las redirige al backend.
