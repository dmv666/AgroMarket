# Variables de producción del backend (ver docs/DESPLIEGUE.md).
# Copiar a .env.prod en el servidor y reemplazar TODOS los valores de ejemplo.
# .env.prod nunca se sube al repositorio.

# --- Dominios ---
# Dominio del backend, apuntando (registro DNS A) a la IP del servidor.
BACKEND_DOMAIN=api.ejemplo.com

# --- Django ---
DEBUG=False
# Generar una nueva con:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=api.ejemplo.com
# URL del frontend en Vercel (sin / al final). Varias separadas por coma.
CORS_ALLOWED_ORIGINS=https://agromarket.vercel.app
# URL pública del backend: necesaria para iniciar sesión en /admin.
CSRF_TRUSTED_ORIGINS=https://api.ejemplo.com

# --- Base de datos ---
POSTGRES_DB=agromarket
POSTGRES_USER=agromarket
# Usar una contraseña fuerte, distinta a la de desarrollo.
POSTGRES_PASSWORD=reemplazar-por-una-contrasena-segura
POSTGRES_PORT=5432
